# Atur sebagai variabel lingkungan server. Jangan commit nilai asli.
NODE_ENV=production
PORT=4000
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
ADMIN_EMAIL=admin@domain-anda.id
ADMIN_PASSWORD=ganti-kata-sandi-kuat
CLIENT_ORIGIN=https://domain-anda.id
